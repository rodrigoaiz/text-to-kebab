---
import Layout from '../layouts/Layout.astro';
import { defaultCanonical, defaultImage } from '../config/site';

const site = import.meta.env.SITE || '';

// Sólo sobrescribimos lo que queremos cambiar; el layout aplicará los valores por defecto.
const seo = {
	title: 'Text to Kebab Case — Convierte texto a kebab-case (soporte español)',
	canonical: defaultCanonical(site),
	image: defaultImage(site)
};
---

<Layout {...seo}>
	<main class="min-h-screen bg-gradient-to-br from-slate-900 to-slate-800 text-slate-50 px-4 py-8">
		<div class="max-w-3xl mx-auto">
			<header class="text-center mb-12">
				<h1 class="text-4xl md:text-5xl font-bold mb-3 bg-gradient-to-r from-indigo-500 to-purple-500 bg-clip-text text-transparent flex items-center justify-center gap-3">
					<!-- Inline kebab SVG icon -->
					<svg class="w-10 h-10 flex-shrink-0 kebab-icon" viewBox="0 0 128 128" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
						<g transform="rotate(-30 64 64)">
							<rect x="60" y="8" width="8" height="112" rx="4" fill="#7c3aed" />
							<rect x="36" y="14" width="40" height="18" rx="6" fill="#c2410c" />
							<rect x="36" y="36" width="40" height="14" rx="6" fill="#f97316" />
							<rect x="36" y="54" width="40" height="18" rx="6" fill="#a3e635" />
						</g>
					</svg>
					<span class="leading-tight">Text to Kebab Case</span>
				</h1>
				<p class="text-slate-300 text-lg">
					Convierte texto a kebab-case con soporte completo para español
				</p>
			</header>

			<div class="bg-slate-800 p-6 md:p-8 rounded-xl border border-slate-700 shadow-2xl mb-8">
				<div class="mb-6">
					<label for="input-text" class="block mb-2 font-semibold text-slate-50">
						Texto original
					</label>
					<textarea 
						id="input-text" 
						placeholder="Escribe algo como: Niño con piñata, Menú del día, ¿Cómo estás?"
						rows="6"
						class="w-full px-4 py-3 bg-slate-900 text-slate-50 border-2 border-slate-600 rounded-lg font-mono resize-y focus:outline-none focus:border-indigo-500 transition-colors placeholder:text-slate-500"
					></textarea>
				</div>

			<!-- Controles -->
			<div class="mb-6">
				<div class="flex flex-col lg:flex-row gap-4 items-start lg:items-end">
					<!-- Selector de formato -->
					<div class="flex-1 w-full lg:w-auto min-w-[200px]">
						<label for="format-select" class="block mb-2 font-semibold text-slate-50">Formato</label>
						<select id="format-select" class="w-full px-3 py-2 bg-slate-900 text-slate-50 border-2 border-slate-600 rounded-lg focus:outline-none focus:border-indigo-500">
							<option value="kebab">kebab-case</option>
							<option value="snake">snake_case</option>
							<option value="camel">camelCase</option>
							<option value="pascal">PascalCase</option>
							<option value="lower">lowercase</option>
							<option value="upper">UPPERCASE</option>
						</select>
					</div>
					<!-- Checkboxes en línea -->
					<div class="flex flex-col sm:flex-row gap-3 sm:gap-4 flex-wrap">
						<label class="inline-flex items-center gap-2 select-none cursor-pointer">
							<input id="ascii-mode" type="checkbox" class="w-4 h-4 accent-indigo-600 cursor-pointer" checked />
							<span class="text-slate-200 text-sm">Quitar acentos/ñ</span>
						</label>
						<label class="inline-flex items-center gap-2 select-none cursor-pointer">
							<input id="remove-stopwords" type="checkbox" class="w-4 h-4 accent-indigo-600 cursor-pointer" />
							<span class="text-slate-200 text-sm">Omitir artículos</span>
						</label>
					</div>
				</div>
			</div>

			<div class="mb-6">
				<div class="flex items-center justify-between mb-2">
					<label for="output-text" class="font-semibold text-slate-50">
						Resultado
						<small id="format-hint" class="ml-2 text-slate-400 font-normal">kebab-case</small>
					</label>
					<!-- Tooltip de ayuda -->
					<button 
						id="help-btn"
						type="button"
						class="relative group"
						aria-label="Ver ejemplos"
					>
						<svg class="w-6 h-6 text-slate-400 hover:text-indigo-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<circle cx="12" cy="12" r="10" stroke-width="2"/>
							<path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" stroke-width="2" stroke-linecap="round"/>
							<circle cx="12" cy="17" r=".5" fill="currentColor"/>
						</svg>
					</button>
				</div>
				<div class="relative">
					<textarea 
						id="output-text" 
						readonly 
						placeholder="El resultado aparecerá aquí..."
						rows="6"
						class="w-full px-4 py-3 bg-slate-900 text-slate-50 border-2 border-slate-600 rounded-lg font-mono resize-y focus:outline-none placeholder:text-slate-500"
					></textarea>
						<button 
							id="copy-btn" 
							class="absolute top-2 right-2 bg-indigo-600 hover:bg-indigo-700 text-white p-2 rounded-md transition-all duration-200 hover:scale-105 active:scale-95 flex items-center justify-center"
							title="Copiar al portapapeles"
						>
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
								<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
							</svg>
						</button>
					</div>
				</div>

				<div class="flex justify-end">
					<button 
						id="clear-btn" 
						class="px-6 py-3 bg-transparent hover:bg-slate-700 text-slate-50 border-2 border-slate-600 rounded-lg font-semibold transition-all duration-200 hover:-translate-y-0.5"
					>
						Limpiar
					</button>
				</div>
			</div>

			<!-- Popup de ayuda -->
			<div 
				id="help-popup" 
				class="hidden fixed inset-0 z-50 items-center justify-center p-4 bg-black/50 backdrop-blur-sm"
			>
				<div class="bg-slate-800 rounded-xl border border-slate-700 p-6 md:p-8 max-w-2xl w-full max-h-[80vh] overflow-y-auto shadow-2xl">
					<div class="flex items-center justify-between mb-4">
						<h3 class="text-xl font-bold text-indigo-400">Ejemplos de uso</h3>
						<button 
							id="close-help-btn"
							type="button"
							class="text-slate-400 hover:text-slate-200 transition-colors"
							aria-label="Cerrar"
						>
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
							</svg>
						</button>
					</div>
					<ul class="space-y-2">
						<li class="text-slate-300">
							<code class="bg-slate-900 px-2 py-1 rounded text-slate-50 font-mono">"Año Nuevo"</code> 
							→ 
							<code class="bg-slate-900 px-2 py-1 rounded text-slate-50 font-mono">"ano-nuevo"</code>
						</li>
						<li class="text-slate-300">
							<code class="bg-slate-900 px-2 py-1 rounded text-slate-50 font-mono">"Niño con piñata"</code> 
							→ 
							<code class="bg-slate-900 px-2 py-1 rounded text-slate-50 font-mono">"nino-con-pinata"</code>
						</li>
						<li class="text-slate-300">
							<code class="bg-slate-900 px-2 py-1 rounded text-slate-50 font-mono">"Menú del día"</code> 
							→ 
							<code class="bg-slate-900 px-2 py-1 rounded text-slate-50 font-mono">"menu-del-dia"</code>
						</li>
						<li class="text-slate-300">
							<code class="bg-slate-900 px-2 py-1 rounded text-slate-50 font-mono">"¿Cómo estás?"</code> 
							→ 
							<code class="bg-slate-900 px-2 py-1 rounded text-slate-50 font-mono">"como-estas"</code>
						</li>
						<li class="text-slate-300">
							<code class="bg-slate-900 px-2 py-1 rounded text-slate-50 font-mono">"Configuración avanzada"</code> 
							→ 
							<code class="bg-slate-900 px-2 py-1 rounded text-slate-50 font-mono">"configuracion-avanzada"</code>
						</li>
					</ul>
					<div class="mt-6 p-4 bg-slate-900 rounded-lg">
						<p class="text-sm text-slate-300">
							<strong class="text-indigo-400">Opciones:</strong><br>
							• <strong>Quitar acentos/ñ:</strong> Convierte á→a, é→e, ñ→n (ideal para URLs)<br>
							• <strong>Omitir artículos:</strong> Elimina palabras como: el, la, de, del, con, en, etc.
						</p>
					</div>
				</div>
			</div>
		</div>
	</main>

	<style>
		.kebab-icon {
			display: inline-block;
			transform-origin: center;
			animation: kebab-bob 4s ease-in-out infinite;
		}

		.kebab-icon:hover {
			animation-play-state: paused;
			transform: translateY(-6px);
			transition: transform 160ms ease-out;
		}

		@keyframes kebab-bob {
			0%, 100% { transform: translateY(0); }
			50% { transform: translateY(-4px); }
		}
	</style>

	<script>
		import { transformText } from '../utils/textToKebab';

		const inputText = document.getElementById('input-text') as HTMLTextAreaElement;
		const outputText = document.getElementById('output-text') as HTMLTextAreaElement;
		const formatSelect = document.getElementById('format-select') as HTMLSelectElement;
		const removeStopwords = document.getElementById('remove-stopwords') as HTMLInputElement;
		const asciiMode = document.getElementById('ascii-mode') as HTMLInputElement;
		const formatHint = document.getElementById('format-hint') as HTMLElement;
		const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement;
		const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;
		const helpBtn = document.getElementById('help-btn') as HTMLButtonElement;
		const helpPopup = document.getElementById('help-popup') as HTMLDivElement;
		const closeHelpBtn = document.getElementById('close-help-btn') as HTMLButtonElement;

		function updateOutput() {
			const fmt = (formatSelect?.value ?? 'kebab') as any;
			const omit = Boolean(removeStopwords?.checked);
			const val = inputText.value;
			const result = transformText(val, { case: fmt, removeStopwords: omit, ascii: Boolean(asciiMode?.checked) });
			outputText.value = result;
			if (formatHint) {
				const hintMap: Record<string,string> = {
					kebab: 'kebab-case',
					snake: 'snake_case',
					camel: 'camelCase',
					pascal: 'PascalCase',
					lower: 'lowercase',
					upper: 'UPPERCASE',
				};
				formatHint.textContent = hintMap[fmt] ?? 'kebab-case';
			}
		}

		// Convertir texto en tiempo real
		inputText.addEventListener('input', updateOutput);
		formatSelect?.addEventListener('change', updateOutput);
		removeStopwords?.addEventListener('change', updateOutput);
		asciiMode?.addEventListener('change', updateOutput);

		// Initialize on load
		updateOutput();

		// Copiar al portapapeles
		copyBtn.addEventListener('click', async () => {
			if (!outputText.value) return;
			
			try {
				await navigator.clipboard.writeText(outputText.value);
				copyBtn.classList.remove('bg-indigo-600', 'hover:bg-indigo-700');
				copyBtn.classList.add('bg-green-600');
				copyBtn.innerHTML = `
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<polyline points="20 6 9 17 4 12"></polyline>
					</svg>
				`;
				
				setTimeout(() => {
					copyBtn.classList.remove('bg-green-600');
					copyBtn.classList.add('bg-indigo-600', 'hover:bg-indigo-700');
					copyBtn.innerHTML = `
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
							<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
						</svg>
					`;
				}, 2000);
			} catch (err) {
				console.error('Error al copiar:', err);
			}
		});

		// Limpiar campos
		clearBtn.addEventListener('click', () => {
			inputText.value = '';
			outputText.value = '';
			inputText.focus();
		});

		// Modal de ayuda
		helpBtn?.addEventListener('click', () => {
			helpPopup?.classList.remove('hidden');
			helpPopup?.classList.add('flex');
		});

		closeHelpBtn?.addEventListener('click', () => {
			helpPopup?.classList.remove('flex');
			helpPopup?.classList.add('hidden');
		});

		// Cerrar al hacer clic fuera del modal
		helpPopup?.addEventListener('click', (e) => {
			if (e.target === helpPopup) {
				helpPopup.classList.remove('flex');
				helpPopup.classList.add('hidden');
			}
		});
	</script>
</Layout>

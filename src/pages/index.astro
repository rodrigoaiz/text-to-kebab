---
import Layout from '../layouts/Layout.astro';
import { defaultCanonical, defaultImage } from '../config/site';

const site = import.meta.env.SITE || '';

// Sólo sobrescribimos lo que queremos cambiar; el layout aplicará los valores por defecto.
const seo = {
	title: 'Text to Kebab Case — Convierte texto a kebab-case (soporte español)',
	canonical: defaultCanonical(site),
	image: defaultImage(site)
};
---

<Layout {...seo}>
	<main class="min-h-screen bg-gradient-to-br from-slate-900 to-slate-800 text-slate-50 px-4 py-8">
		<div class="max-w-3xl mx-auto">
			<header class="text-center mb-12">
				<h1 class="text-4xl md:text-5xl font-bold mb-3 bg-gradient-to-r from-indigo-500 to-purple-500 bg-clip-text text-transparent">
					📝 Text to Kebab Case
				</h1>
				<p class="text-slate-300 text-lg">
					Convierte texto a kebab-case con soporte completo para español
				</p>
			</header>

			<div class="bg-slate-800 p-6 md:p-8 rounded-xl border border-slate-700 shadow-2xl mb-8">
				<div class="mb-6">
					<label for="input-text" class="block mb-2 font-semibold text-slate-50">
						Texto original
					</label>
					<textarea 
						id="input-text" 
						placeholder="Escribe algo como: Niño con piñata, Menú del día, ¿Cómo estás?"
						rows="6"
						class="w-full px-4 py-3 bg-slate-900 text-slate-50 border-2 border-slate-600 rounded-lg font-mono resize-y focus:outline-none focus:border-indigo-500 transition-colors placeholder:text-slate-500"
					></textarea>
				</div>

				<div class="mb-6">
					<label for="output-text" class="block mb-2 font-semibold text-slate-50">
						Resultado en kebab-case
					</label>
					<div class="relative">
						<textarea 
							id="output-text" 
							readonly 
							placeholder="El resultado aparecerá aquí..."
							rows="6"
							class="w-full px-4 py-3 bg-slate-900 text-slate-50 border-2 border-slate-600 rounded-lg font-mono resize-y focus:outline-none placeholder:text-slate-500"
						></textarea>
						<button 
							id="copy-btn" 
							class="absolute top-2 right-2 bg-indigo-600 hover:bg-indigo-700 text-white p-2 rounded-md transition-all duration-200 hover:scale-105 active:scale-95 flex items-center justify-center"
							title="Copiar al portapapeles"
						>
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
								<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
							</svg>
						</button>
					</div>
				</div>

				<div class="flex justify-end">
					<button 
						id="clear-btn" 
						class="px-6 py-3 bg-transparent hover:bg-slate-700 text-slate-50 border-2 border-slate-600 rounded-lg font-semibold transition-all duration-200 hover:-translate-y-0.5"
					>
						Limpiar
					</button>
				</div>
			</div>

			<div class="bg-slate-800 p-6 md:p-8 rounded-xl border border-slate-700">
				<h3 class="text-xl font-bold mb-4 text-indigo-400">Ejemplos:</h3>
				<ul class="space-y-2">
					<li class="text-slate-300">
						<code class="bg-slate-900 px-2 py-1 rounded text-slate-50 font-mono">"Año Nuevo"</code> 
						→ 
						<code class="bg-slate-900 px-2 py-1 rounded text-slate-50 font-mono">"ano-nuevo"</code>
					</li>
					<li class="text-slate-300">
						<code class="bg-slate-900 px-2 py-1 rounded text-slate-50 font-mono">"Niño con piñata"</code> 
						→ 
						<code class="bg-slate-900 px-2 py-1 rounded text-slate-50 font-mono">"nino-con-pinata"</code>
					</li>
					<li class="text-slate-300">
						<code class="bg-slate-900 px-2 py-1 rounded text-slate-50 font-mono">"Menú del día"</code> 
						→ 
						<code class="bg-slate-900 px-2 py-1 rounded text-slate-50 font-mono">"menu-del-dia"</code>
					</li>
					<li class="text-slate-300">
						<code class="bg-slate-900 px-2 py-1 rounded text-slate-50 font-mono">"¿Cómo estás?"</code> 
						→ 
						<code class="bg-slate-900 px-2 py-1 rounded text-slate-50 font-mono">"como-estas"</code>
					</li>
					<li class="text-slate-300">
						<code class="bg-slate-900 px-2 py-1 rounded text-slate-50 font-mono">"Configuración avanzada"</code> 
						→ 
						<code class="bg-slate-900 px-2 py-1 rounded text-slate-50 font-mono">"configuracion-avanzada"</code>
					</li>
				</ul>
			</div>
		</div>
	</main>

	<script>
		import { textToKebab } from '../utils/textToKebab';

		const inputText = document.getElementById('input-text') as HTMLTextAreaElement;
		const outputText = document.getElementById('output-text') as HTMLTextAreaElement;
		const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement;
		const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;

		// Convertir texto en tiempo real
		inputText.addEventListener('input', () => {
			const result = textToKebab(inputText.value);
			outputText.value = result;
		});

		// Copiar al portapapeles
		copyBtn.addEventListener('click', async () => {
			if (!outputText.value) return;
			
			try {
				await navigator.clipboard.writeText(outputText.value);
				copyBtn.classList.remove('bg-indigo-600', 'hover:bg-indigo-700');
				copyBtn.classList.add('bg-green-600');
				copyBtn.innerHTML = `
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<polyline points="20 6 9 17 4 12"></polyline>
					</svg>
				`;
				
				setTimeout(() => {
					copyBtn.classList.remove('bg-green-600');
					copyBtn.classList.add('bg-indigo-600', 'hover:bg-indigo-700');
					copyBtn.innerHTML = `
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
							<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
						</svg>
					`;
				}, 2000);
			} catch (err) {
				console.error('Error al copiar:', err);
			}
		});

		// Limpiar campos
		clearBtn.addEventListener('click', () => {
			inputText.value = '';
			outputText.value = '';
			inputText.focus();
		});
	</script>
</Layout>

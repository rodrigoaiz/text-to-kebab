---
import Layout from "../layouts/Layout.astro";
import { defaultCanonical, defaultImage } from "../config/site";

const site = import.meta.env.SITE || "";

const seo = {
  title: "Text to Kebab Case — Conversor Full Stack para Desarrolladores",
  description:
    "Convierte texto a kebab-case, snake_case, camelCase y formatos matemáticos como Superíndice. Optimizado para español y SEO.",
  canonical: defaultCanonical(site),
  image: defaultImage(site),
};

const blankSpaces = [
  { name: "NBSP", value: "\u00A0", desc: "Espacio duro" },
  { name: "ZWSP", value: "\u200B", desc: "Ancho cero" },
  { name: "Hair", value: "\u200A", desc: "Ultra fino" },
  { name: "Thin", value: "\u2009", desc: "Espacio fino" },
  { name: "En", value: "\u2002", desc: "Espacio En" },
  { name: "Em", value: "\u2003", desc: "Espacio Em" },
];
---

<Layout {...seo}>
  <main
    class="min-h-screen bg-[#020617] text-slate-50 relative overflow-hidden font-['Outfit']"
  >
    <!-- Decorative Background Elements -->
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-indigo-500/10 blur-[120px] rounded-full -z-10"
    >
    </div>
    <div
      class="absolute -bottom-48 -right-48 w-[600px] h-[600px] bg-purple-500/10 blur-[120px] rounded-full -z-10"
    >
    </div>

    <!-- Grid Pattern -->
    <div
      class="absolute inset-0 bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-20 pointer-events-none -z-10"
    >
    </div>
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] -z-10"
    >
    </div>

    <div class="max-w-4xl mx-auto px-6 py-12 md:py-20">
      <header
        class="text-center mb-16 animate-in fade-in slide-in-from-top-4 duration-1000"
      >
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-sm font-medium mb-6"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"
            ></span>
            <span
              class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"
            ></span>
          </span>
          v2.0 — Ahora con Superíndices y Espacios
        </div>
        <h1
          class="text-5xl md:text-7xl font-bold tracking-tight mb-6 bg-gradient-to-b from-white to-slate-400 bg-clip-text text-transparent italic"
        >
          Text to <span
            class="bg-gradient-to-r from-indigo-400 to-purple-400 bg-clip-text"
            >Kebab</span
          >
        </h1>
        <p
          class="text-slate-400 text-lg md:text-xl max-w-2xl mx-auto leading-relaxed"
        >
          La herramienta definitiva para transformar texto. De slugs amigables
          para SEO hasta fórmulas matemáticas en un clic.
        </p>
      </header>

      <div class="grid gap-8">
        <!-- Main Converter Card -->
        <div class="group relative">
          <div
            class="absolute -inset-0.5 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-3xl blur opacity-20 group-hover:opacity-40 transition duration-1000"
          >
          </div>
          <div
            class="relative bg-slate-900/80 backdrop-blur-xl p-6 md:p-10 rounded-3xl border border-slate-800 shadow-2xl"
          >
            <div class="flex flex-col gap-8">
              <!-- Input -->
              <div class="space-y-3">
                <div class="flex justify-between items-center">
                  <label
                    for="input-text"
                    class="text-sm font-semibold text-slate-400 uppercase tracking-wider"
                    >Entrada</label
                  >
                  <span id="char-count" class="text-xs text-slate-500 font-mono"
                    >0 caracteres</span
                  >
                </div>
                <textarea
                  id="input-text"
                  placeholder="Pega tu texto aquí... (ej: Octava edición, x2 + y2)"
                  rows="4"
                  class="w-full px-5 py-4 bg-slate-950/50 text-white border border-slate-800 rounded-2xl font-mono text-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500/50 transition-all placeholder:text-slate-600 resize-none"
                ></textarea>
              </div>

              <!-- Config & Options -->
              <div
                class="grid grid-cols-1 md:grid-cols-2 gap-6 p-6 bg-slate-950/30 rounded-2xl border border-slate-800/50"
              >
                <div class="space-y-3">
                  <label
                    for="format-select"
                    class="text-sm font-semibold text-slate-400 uppercase tracking-wider"
                    >Formato de salida</label
                  >
                  <div class="relative">
                    <select
                      id="format-select"
                      class="w-full appearance-none px-4 py-3 bg-slate-900 text-white border border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/50 transition-all cursor-pointer"
                    >
                      <optgroup label="Desarrollo">
                        <option value="kebab">kebab-case</option>
                        <option value="snake">snake_case</option>
                        <option value="camel">camelCase</option>
                        <option value="pascal">PascalCase</option>
                      </optgroup>
                      <optgroup label="Texto">
                        <option value="lower">minúsculas</option>
                        <option value="upper">MAYÚSCULAS</option>
                      </optgroup>
                      <optgroup label="Matemáticas / Subscript">
                        <option value="superscript">Superíndice (x²)</option>
                        <option value="subscript">Subíndice (x₂)</option>
                      </optgroup>
                    </select>
                    <div
                      class="absolute inset-y-0 right-3 flex items-center pointer-events-none text-slate-500"
                    >
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M19 9l-7 7-7-7"></path></svg
                      >
                    </div>
                  </div>
                </div>

                <div class="flex flex-col justify-center gap-4">
                  <label
                    class="flex items-center gap-3 cursor-pointer group/check"
                  >
                    <div class="relative flex items-center">
                      <input
                        id="ascii-mode"
                        type="checkbox"
                        class="peer sr-only"
                        checked
                      />
                      <div
                        class="w-5 h-5 border-2 border-slate-600 rounded-md peer-checked:bg-indigo-500 peer-checked:border-indigo-500 transition-all"
                      >
                      </div>
                      <svg
                        class="absolute w-3.5 h-3.5 text-white scale-0 peer-checked:scale-100 transition-transform left-0.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        stroke-width="4"><path d="M5 13l4 4L19 7"></path></svg
                      >
                    </div>
                    <span
                      class="text-slate-300 group-hover/check:text-white transition-colors"
                      >Limpiar acentos/ñ</span
                    >
                  </label>
                  <label
                    class="flex items-center gap-3 cursor-pointer group/check"
                  >
                    <div class="relative flex items-center">
                      <input
                        id="remove-stopwords"
                        type="checkbox"
                        class="peer sr-only"
                      />
                      <div
                        class="w-5 h-5 border-2 border-slate-600 rounded-md peer-checked:bg-indigo-500 peer-checked:border-indigo-500 transition-all"
                      >
                      </div>
                      <svg
                        class="absolute w-3.5 h-3.5 text-white scale-0 peer-checked:scale-100 transition-transform left-0.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        stroke-width="4"><path d="M5 13l4 4L19 7"></path></svg
                      >
                    </div>
                    <span
                      class="text-slate-300 group-hover/check:text-white transition-colors"
                      >Omitir artículos</span
                    >
                  </label>
                </div>
              </div>

              <!-- Output -->
              <div class="space-y-3">
                <div class="flex justify-between items-center">
                  <label
                    for="output-text"
                    class="text-sm font-semibold text-slate-400 uppercase tracking-wider"
                    >Resultado</label
                  >
                  <div class="flex gap-2">
                    <button
                      id="clear-btn"
                      class="text-xs text-slate-500 hover:text-red-400 transition-colors flex items-center gap-1"
                    >
                      <svg
                        class="w-3 h-3"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"></path></svg
                      >
                      Limpiar
                    </button>
                  </div>
                </div>
                <div class="relative group/output">
                  <textarea
                    id="output-text"
                    readonly
                    placeholder="El resultado aparecerá mágicamente aquí..."
                    rows="4"
                    class="w-full px-5 py-4 bg-indigo-500/5 text-indigo-100 border border-indigo-500/20 rounded-2xl font-mono text-lg focus:outline-none transition-all placeholder:text-slate-700 resize-none selection:bg-indigo-500/30"
                  ></textarea>
                  <button
                    id="copy-btn"
                    class="absolute top-4 right-4 bg-indigo-500 hover:bg-indigo-600 text-white px-4 py-2 rounded-xl transition-all flex items-center gap-2 shadow-lg shadow-indigo-500/20 active:scale-95"
                  >
                    <span id="copy-text">Copiar</span>
                    <svg
                      id="copy-icon"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"
                      ></rect>
                      <path
                        d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                      ></path>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Blank Spaces Sidebar/Section -->
        <section
          class="animate-in fade-in slide-in-from-bottom-4 duration-1000 delay-200"
        >
          <div
            class="bg-slate-900/40 backdrop-blur-sm border border-slate-800/50 p-8 rounded-3xl"
          >
            <div class="flex items-center gap-3 mb-6">
              <div class="p-2 bg-indigo-500/10 rounded-lg text-indigo-400">
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    d="M4 7h16M4 11h16M4 15h16M4 19h16"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"></path></svg
                >
              </div>
              <div>
                <h2 class="text-xl font-bold text-white">
                  Caracteres Invisibles
                </h2>
                <p class="text-sm text-slate-500">
                  Copia espacios especiales para maquetación o trucos de texto
                </p>
              </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
              {
                blankSpaces.map((space) => (
                  <button
                    class="blank-space-btn group relative p-4 bg-slate-950 border border-slate-800 rounded-2xl hover:border-indigo-500/50 hover:bg-slate-900 transition-all text-center"
                    data-value={space.value}
                    title={space.desc}
                  >
                    <span class="block text-xs font-bold text-indigo-400 mb-1">
                      {space.name}
                    </span>
                    <span class="block text-[10px] text-slate-500 truncate">
                      {space.desc}
                    </span>
                    <div class="absolute inset-0 flex items-center justify-center bg-indigo-600 rounded-2xl opacity-0 group-active:opacity-100 transition-opacity">
                      <svg
                        class="w-5 h-5 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          d="M5 13l4 4L19 7"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="3"
                        />
                      </svg>
                    </div>
                  </button>
                ))
              }
            </div>
          </div>
        </section>

        <!-- SEO / Info Section -->
        <section class="mt-12 md:mt-20">
          <div class="prose prose-invert max-w-none">
            <div class="grid md:grid-cols-3 gap-12">
              <div class="space-y-4">
                <h3 class="text-indigo-400 font-bold text-lg">Slugify Ready</h3>
                <p class="text-slate-400 text-sm leading-relaxed">
                  Perfecto para desarrolladores que necesitan nombres de
                  variables o URLs limpias. Soporta ñ, acentos y evita
                  caracteres ilegales automáticamente.
                </p>
              </div>
              <div class="space-y-4">
                <h3 class="text-purple-400 font-bold text-lg">
                  Fórmulas Rápidas
                </h3>
                <p class="text-slate-400 text-sm leading-relaxed">
                  Convierte instantáneamente números y letras a superíndices
                  (X²) o subíndices (H₂O) sin necesidad de HTML o herramientas
                  complejas.
                </p>
              </div>
              <div class="space-y-4">
                <h3 class="text-indigo-400 font-bold text-lg">Privacy First</h3>
                <p class="text-slate-400 text-sm leading-relaxed">
                  Todo el procesamiento ocurre en tu navegador local. Nada de lo
                  que escribes sale de tu computadora. Rápido y seguro.
                </p>
              </div>
            </div>
          </div>
        </section>
      </div>

      <footer class="mt-24 pt-8 border-t border-slate-800 text-center">
        <p class="text-slate-500 text-sm">
          Diseñado con ❤️ por <a
            href="https://rodrigo-aizpuru-portfolio.vercel.app"
            class="text-indigo-400 hover:text-indigo-300 transition-colors"
            >Rodrigo Aizpuru</a
          >
        </p>
      </footer>
    </div>
  </main>

  <script>
    import { transformText } from "../utils/textToKebab";

    // Elements
    const inputText = document.getElementById(
      "input-text",
    ) as HTMLTextAreaElement;
    const outputText = document.getElementById(
      "output-text",
    ) as HTMLTextAreaElement;
    const formatSelect = document.getElementById(
      "format-select",
    ) as HTMLSelectElement;
    const removeStopwords = document.getElementById(
      "remove-stopwords",
    ) as HTMLInputElement;
    const asciiMode = document.getElementById("ascii-mode") as HTMLInputElement;
    const copyBtn = document.getElementById("copy-btn") as HTMLButtonElement;
    const copyText = document.getElementById("copy-text") as HTMLSpanElement;
    const clearBtn = document.getElementById("clear-btn") as HTMLButtonElement;
    const charCount = document.getElementById("char-count") as HTMLElement;
    const blankSpaceBtns = document.querySelectorAll(".blank-space-btn");

    function updateOutput() {
      const val = inputText.value;
      const fmt = (formatSelect?.value ?? "kebab") as any;
      const omit = Boolean(removeStopwords?.checked);
      const ascii = Boolean(asciiMode?.checked);

      const result = transformText(val, {
        case: fmt,
        removeStopwords: omit,
        ascii: ascii,
      });

      outputText.value = result;
      charCount.textContent = `${val.length} caracteres`;
    }

    // Event Listeners
    inputText.addEventListener("input", updateOutput);
    formatSelect.addEventListener("change", updateOutput);
    removeStopwords.addEventListener("change", updateOutput);
    asciiMode.addEventListener("change", updateOutput);

    // Copiar logic
    async function copyToClipboard(text: string, btn: HTMLButtonElement) {
      try {
        await navigator.clipboard.writeText(text);

        if (btn.id === "copy-btn") {
          btn.classList.add("bg-green-600", "hover:bg-green-700", "scale-105");
          if (copyText) copyText.textContent = "¡Copiado!";
          setTimeout(() => {
            btn.classList.remove(
              "bg-green-600",
              "hover:bg-green-700",
              "scale-105",
            );
            if (copyText) copyText.textContent = "Copiar";
          }, 2000);
        }
      } catch (err) {
        console.error("Error:", err);
      }
    }

    copyBtn.addEventListener("click", () => {
      if (outputText.value) copyToClipboard(outputText.value, copyBtn);
    });

    clearBtn.addEventListener("click", () => {
      inputText.value = "";
      updateOutput();
      inputText.focus();
    });

    // Blank spaces copy
    blankSpaceBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const val = btn.getAttribute("data-value");
        if (val) copyToClipboard(val, btn as HTMLButtonElement);
      });
    });

    // Init
    updateOutput();
  </script>
</Layout>

<style>
  /* Custom animations and scrollbars */
  textarea::-webkit-scrollbar {
    width: 8px;
  }
  textarea::-webkit-scrollbar-track {
    background: transparent;
  }
  textarea::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
  }
  textarea::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .animate-in {
    animation-fill-mode: both;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes slide-in-from-top-4 {
    from {
      transform: translateY(-1rem);
    }
    to {
      transform: translateY(0);
    }
  }
  @keyframes slide-in-from-bottom-4 {
    from {
      transform: translateY(1rem);
    }
    to {
      transform: translateY(0);
    }
  }

  .fade-in {
    animation-name: fade-in;
  }
  .slide-in-from-top-4 {
    animation-name: slide-in-from-top-4;
  }
  .slide-in-from-bottom-4 {
    animation-name: slide-in-from-bottom-4;
  }
</style>
